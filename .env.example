ORIGIN=http://localhost:5173
DATABASE_URL=postgres://teilchen:teilchen@localhost:5432/teilchen
# 32 bytes, base64 – e.g. `openssl rand -base64 32`. Encrypts REWE tokens in the DB.
APP_SECRET=

# Authentik: provider "OAuth2/OpenID", redirect URI = $ORIGIN/auth/callback
OIDC_ISSUER=https://auth.example.com/application/o/teilchen/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# eBon inbox (the worker reads it via IMAP)
INBOX_ADDRESS=teilchen@example.com
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# REWE mobile API (unofficial): client certificate, see README
REWE_CERT_PATH=./certs/rewe.pem
REWE_KEY_PATH=./certs/rewe.key
