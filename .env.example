ORIGIN=http://localhost:5173
DATABASE_URL=postgres://teilchen:teilchen@localhost:5432/teilchen
# 32 Byte, base64 – z.B. `openssl rand -base64 32`. Verschlüsselt REWE-Tokens in der DB.
APP_SECRET=

# Authentik: Provider "OAuth2/OpenID", Redirect-URI = $ORIGIN/auth/callback
OIDC_ISSUER=https://auth.example.de/application/o/teilchen/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# eBon-Postfach (Worker liest per IMAP)
INBOX_ADDRESS=teilchen@nauren.de
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# REWE Mobile-API (inoffiziell): Client-Zertifikat, siehe README
REWE_CERT_PATH=./certs/rewe.pem
REWE_KEY_PATH=./certs/rewe.key
