{
	"name": "teilchen",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"verify": "pnpm check && pnpm lint && pnpm test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file-if-exists=.env src/lib/server/db/migrate.ts",
		"prepare": "svelte-kit sync || echo ''",
		"db:seed": "tsx --env-file-if-exists=.env src/lib/server/db/seed.ts"
	},
	"dependencies": {
		"@tabler/icons": "3.49.0",
		"@tabler/icons-svelte": "^3.49.0",
		"drizzle-orm": "^0.45.4",
		"imapflow": "^2.9.1",
		"mailparser": "^3.12.4",
		"openid-client": "^6.8.8",
		"postgres": "^3.4.9",
		"tsx": "^4.23.15",
		"unpdf": "^1.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/mailparser": "^3.9.0",
		"@types/node": "^26.6.5",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "pnpm@10.28.0"
}
